{
  "name": "wormsign",
  "version": "1.0.0",
  "description": "Find agent worms (Miasma, Mini Shai-Hulud) in a GitHub account or organization through the API only: autorun agent hooks, folderOpen tasks, hidden payloads, backdated commits and exfiltration repositories.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wormsign": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "!dist/action*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build",
    "pack:check": "pnpm pack --dry-run"
  },
  "keywords": [
    "security",
    "supply-chain",
    "malware",
    "worm",
    "shai-hulud",
    "miasma",
    "claude-code",
    "cursor",
    "ai-agents",
    "github",
    "sarif"
  ],
  "author": "Mickael Saidi (https://nukoe.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nukoe-labs/wormsign.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.34.9"
}
